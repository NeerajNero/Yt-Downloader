# Machine-local settings — copy to .env (gitignored) and edit. Every key is
# optional; the defaults work for a checkout with ffmpeg on PATH.

# Where the library lives (one folder per video). Relative = under the project.
# Windows example: D:\ytstudio\library     Mac example: /Users/you/Movies/ingest
#LIBRARY_DIR=downloads

# Bind address + port. 127.0.0.1 = this machine only. Use 0.0.0.0 to reach the
# app from your phone on the LAN / tailnet (http://<this-pc's-tailscale-ip>:8765).
#HOST=127.0.0.1
#PORT=8765
# Open the browser when the app starts.
#OPEN_BROWSER=true

# ffmpeg binary. Auto-detected: Homebrew ffmpeg-full (macOS, has libass for
# captions), PATH, or WinGet's Gyan.FFmpeg full build (Windows).
#FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# H.264 encoder: auto (tests h264_amf / h264_nvenc on Windows, videotoolbox on
# macOS, else libx264), or force one of libx264 h264_amf h264_nvenc h264_videotoolbox.
#ENCODER=auto

# Whisper: tiny / base / small / medium / large-v3. CPU by default; on a machine
# with an NVIDIA GPU set WHISPER_DEVICE=cuda (compute becomes int8_float16).
#WHISPER_MODEL=small
#WHISPER_DEVICE=cpu
#WHISPER_COMPUTE=int8
#WHISPER_LANGUAGE=

# Netscape-format cookies file for age-restricted / logged-in downloads.
#COOKIES_FILE=cookies.txt

# Google Gemini API key — enables clip suggestions, post kits, edit plans and
# style clone. Get one at https://aistudio.google.com/apikey
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.5-flash
# Fallback chain tried in order when a model is saturated (503) or rate-limited (429).
#GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# How many jobs run at once: heavy = ffmpeg/whisper (keep at 1), light = downloads + Gemini.
#HEAVY_JOBS=1
#LIGHT_JOBS=2
# Scratch folder for temporary files.
#WORK_DIR=work
