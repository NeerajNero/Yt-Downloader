# Machine-local overrides — copy to .env (gitignored) and edit.
# config.json holds shared defaults; anything set here wins on this machine
# only, so Mac and Windows setups never conflict in git.

# Where downloads land. Relative resolves against the project root.
# Windows example: D:\capture     Mac example: /Users/you/Movies/ingest
#DOWNLOAD_DIR=downloads

#PORT=8765

# Netscape-format cookies file for age-restricted videos.
#COOKIES_FILE=cookies.txt

# Enables the Pipeline button: command that receives the video file path
# as its last argument. Shell-style string.
# Windows example: PIPELINE_CMD=python D:\vod-pipeline\autopipe.py
#PIPELINE_CMD=

# Google Gemini API key — enables AI clip suggestions and Auto Shorts.
# Get one at https://aistudio.google.com/apikey
#GEMINI_API_KEY=

# Gemini model for clip suggestions / post kits / style clone (default gemini-2.5-flash).
#GEMINI_MODEL=gemini-2.5-flash
# Fallback chain, tried in order when a model is saturated (503) or rate-limited
# (429). More → AI models in the PWA shows what your key can call.
#GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# Whisper model for transcription: tiny / base / small / medium / large-v3.
# Bigger = more accurate but slower. Downloads once on first use.
#WHISPER_MODEL=small

# ── v2 brain stack (Docker Compose) ─────────────────────────────────────────
# Postgres superuser password (compose + workers use it).
#POSTGRES_PASSWORD=change-me

# Hasura admin secret — also baked into the PWA bundle at build time.
#HASURA_ADMIN_SECRET=change-me

# Host port for Postgres (workers connect here over the tailnet).
# 5432 on the Ubuntu server; 5433 on the Mac (local postgres owns 5432).
#POSTGRES_PORT=5432

# Host port for the web entry point (Caddy). tailscale serve points here.
#WEB_PORT=8080

# Host port for the Hasura console/CLI (admin use only).
#HASURA_PORT=8081

# Where the media library lives on the brain (mounted into the api container).
#LIBRARY_DIR=/srv/yt-studio/library

# Wake-on-LAN is off by default. To turn it on: WOL_ENABLED=true, put the gaming
# PC's MAC in machines.mac_address, and start the sidecar once with
# `docker compose --profile wol up -d`.
#WOL_ENABLED=false
# LAN broadcast address for Wake-on-LAN (default 255.255.255.255 is fine on one LAN).
#WOL_BROADCAST=192.168.0.255

# Job types the brain's own worker claims (comma-separated). Add `render` to
# let the brain render (slow, libx264) when the gaming PC is off.
#BRAIN_WORKER_CAPABILITIES=download,scenes,borders,convert,clippack,tighten,suggest,postkit
