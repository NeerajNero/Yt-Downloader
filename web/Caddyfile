:80 {
	encode gzip

	# Hasura GraphQL (http + websocket subscriptions)
	handle /v1/* {
		reverse_proxy hasura:8080
	}
	handle /v2/* {
		reverse_proxy hasura:8080
	}

	# Brain API (Actions, files, WoL)
	handle /api/* {
		reverse_proxy api:8000
	}

	# The PWA
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
